# Copia questo file in .env.prod e valorizza i segreti prima di avviare
# docker-compose.prod.yml. .env.prod non va committato (vedi .gitignore).

# --- Postgres (container "db") ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gestionale

# --- Applicazione (container "app") ---
# Deve puntare al servizio "db" della rete interna del compose, con le stesse
# credenziali definite sopra.
DATABASE_URL="postgresql://admin:change-me@db:5432/gestionale?schema=public"
# Genera un valore casuale, es. con `openssl rand -base64 48`: l'app rifiuta
# di avviarsi se JWT_SECRET è più corto di 32 byte o è un segnaposto noto
# come "change-me" (vedi lib/auth/jwt.ts) — con HS256, chi conosce questo
# segreto può forgiare un token di sessione valido per qualunque utente.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Imposta a "true" SOLO se l'app è dietro un reverse proxy che tu controlli e
# che sovrascrive X-Forwarded-For/X-Real-IP con l'IP client reale (es. nginx,
# Cloudflare con IP ristretti). Senza un proxy così configurato, questi header
# sono forniti direttamente dal client e falsificabili: un utente malintenzionato
# potrebbe usarli per aggirare il blocco per IP sui tentativi di login falliti
# (vedi lib/auth/client-ip.ts). Default: "false" (non fidarsi degli header).
TRUSTED_PROXY=false

# Porta pubblicata sull'host per l'app (default 3000 se non impostata)
APP_PORT=3000

# --- Backup (container "backup") ---
# Ogni quanti secondi eseguire un pg_dump (default: 86400 = 1 giorno)
BACKUP_INTERVAL_SECONDS=86400
# Per quanti giorni conservare i dump in ./backups (default: 14)
BACKUP_RETENTION_DAYS=14
