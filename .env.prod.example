# Copia questo file in .env.prod e valorizza i segreti prima di avviare
# docker-compose.prod.yml. .env.prod non va committato (vedi .gitignore).

# --- Postgres (container "db") ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gestionale

# --- Applicazione (container "app") ---
# Deve puntare al servizio "db" della rete interna del compose, con le stesse
# credenziali definite sopra.
# ATTENZIONE: questa URL non specifica `sslmode`, quindi la connessione a
# Postgres viaggia in chiaro. Oggi è accettabile perché "app" e "db" girano
# sulla stessa macchina, sulla rete Docker interna del compose (il traffico
# non esce mai sull'host). Se in futuro il database viene spostato su una
# macchina/host separato (es. un Postgres gestito, o un DB remoto), aggiungi
# `&sslmode=require` alla fine di questa URL PRIMA di quel cambio.
DATABASE_URL="postgresql://admin:change-me@db:5432/gestionale?schema=public"
# Genera un valore casuale, es. con `openssl rand -base64 48`: l'app rifiuta
# di avviarsi se JWT_SECRET è più corto di 32 byte o è un segnaposto noto
# come "change-me" (vedi lib/auth/jwt.ts) — con HS256, chi conosce questo
# segreto può forgiare un token di sessione valido per qualunque utente.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Imposta a "true" SOLO se l'app è dietro un reverse proxy che tu controlli e
# che sovrascrive X-Forwarded-For/X-Real-IP con l'IP client reale (es. nginx,
# Cloudflare con IP ristretti). Senza un proxy così configurato, questi header
# sono forniti direttamente dal client e falsificabili: un utente malintenzionato
# potrebbe usarli per aggirare il blocco per IP sui tentativi di login falliti
# (vedi lib/auth/client-ip.ts). Default: "false" (non fidarsi degli header).
TRUSTED_PROXY=false

# Porta pubblicata sull'host per l'app (default 3000 se non impostata)
APP_PORT=3000

# Fuso orario del processo. L'app è per uno studio italiano e calcola i confini
# di anno/mese degli aggregati fatturato in ora locale del processo (LOG-12):
# va tenuto su Europe/Rome. NOTA: questa riga è solo un default documentativo —
# Node legge TZ dall'ambiente all'avvio, PRIMA che i file .env vengano caricati,
# quindi da sola non cambia in modo affidabile il fuso del processo.
# L'enforcement reale è: `ENV TZ=Europe/Rome` nel Dockerfile (produzione) e il
# prefisso `cross-env TZ=Europe/Rome` sugli script `dev`/`start` in
# package.json (cross-env, non un prefisso POSIX diretto: alcuni ambienti di
# sviluppo risolvono npm/node di Windows anche da un prompt bash via WSL, dove
# gli script vengono eseguiti da cmd.exe, che non capisce `VAR=val comando`).
TZ=Europe/Rome

# --- Bootstrap del primo amministratore ---
# Usate SOLO da `node prisma/seed.mjs`, eseguito una volta a database vuoto
# (`docker compose -f docker-compose.prod.yml exec app node prisma/seed.mjs`).
# Lo script non fa nulla se esiste già un amministratore. La password deve
# rispettare la policy dell'app (min 12 caratteri, vedi lib/validations/user.ts)
# ed è temporanea: al primo accesso l'app segnala di cambiarla. Dopo il primo
# avvio queste due righe possono essere rimosse.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-min-12-caratteri

# --- Backup (container "backup") ---
# Ogni quanti secondi eseguire un pg_dump (default: 86400 = 1 giorno)
BACKUP_INTERVAL_SECONDS=86400
# Per quanti giorni conservare i dump in ./backups (default: 14)
BACKUP_RETENTION_DAYS=14
# Passphrase usata da GPG per cifrare (AES256, simmetrico) ogni dump prima di
# scriverlo su disco. Obbligatoria: senza questa variabile lo script di backup
# si rifiuta di partire. Genera un valore casuale, es. con
# `openssl rand -base64 48`, e conservalo altrove (non solo in .env.prod):
# serve per il ripristino, vedi README-BACKUP.md.
BACKUP_ENCRYPTION_KEY=change-me
