generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
}

model Utente {
  id               Int         @id @default(autoincrement())
  username         String      @unique
  passwordHash     String
  nome             String?
  cognome          String?
  pIva             String?
  cf               String?
  via              String?
  citta            String?
  provincia        String?
  titolo           String?
  specializzazione String?
  isAdmin          Boolean     @default(false)
  abilitato        Boolean     @default(true)
  createdAt        DateTime    @default(now())

  paganti          Pagante[]
  pazienti         Paziente[]
  pagamenti        Pagamento[]

  @@map("utenti")
}

model Pagante {
  id        Int         @id @default(autoincrement())
  id_Utente Int
  nome      String
  cognome   String
  via       String
  citta     String
  cap       String
  cf        String?
  piva      String?
  eliminato Boolean     @default(false)

  utente    Utente      @relation(fields: [id_Utente], references: [id])
  pazienti  Paziente[]
  pagamenti Pagamento[]

  @@unique([id_Utente, cf])
  @@unique([id_Utente, piva])
  @@map("paganti")
}

model Paziente {
  id         Int         @id @default(autoincrement())
  id_Utente  Int
  id_Pagante Int?
  nome       String
  cognome    String
  eliminato  Boolean     @default(false)

  utente     Utente      @relation(fields: [id_Utente], references: [id])
  pagante    Pagante?    @relation(fields: [id_Pagante], references: [id])
  sedute     Seduta[]
  pagamenti  Pagamento[]

  @@map("pazienti")
}

model Pagamento {
  id            Int           @id @default(autoincrement())
  id_Utente     Int
  id_Pagante    Int
  id_Paziente   Int
  prezzo_totale Float
  mod_pag       String         // Convertito da ENUM ('CONTANTI','CARTA','BONIFICO') a String per SQLite
  sedute        Int?
  commento      String?
  n_fattura     Int
  data          DateTime
  citta         String
  cap           String         @default("")

  utente        Utente         @relation(fields: [id_Utente], references: [id])
  pagante       Pagante        @relation(fields: [id_Pagante], references: [id])
  paziente      Paziente       @relation(fields: [id_Paziente], references: [id])
  mesi          FatturaMese[]

  @@map("pagamenti")
}

model FatturaMese {
  id           Int       @id @default(autoincrement())
  id_Pagamento Int
  mese         String

  pagamento    Pagamento @relation(fields: [id_Pagamento], references: [id], onDelete: Cascade)

  @@unique([id_Pagamento, mese])
  @@map("fattura_mesi")
}

model Seduta {
  id          Int      @id @default(autoincrement())
  id_Paziente Int
  prezzo      Float
  data        DateTime
  pagato      Boolean  @default(false)

  paziente    Paziente @relation(fields: [id_Paziente], references: [id])

  @@map("sedute")
}