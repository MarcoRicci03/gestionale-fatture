generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
}

model Utente {
  id               Int              @id @default(autoincrement())
  username         String           @unique
  passwordHash     String
  nome             String?
  cognome          String?
  pIva             String?
  cf               String?
  via              String?
  citta            String?
  cap              String?
  provincia        String?
  titolo           String?
  specializzazione String?
  isAdmin          Boolean          @default(false)
  abilitato        Boolean          @default(true)
  createdAt        DateTime         @default(now())

  paganti          Pagante[]
  pazienti         Paziente[]
  pagamenti        Pagamento[]
  impostazioniPdf  ImpostazioniPdf?

  @@map("utenti")
}

model Pagante {
  id        Int         @id @default(autoincrement())
  id_Utente Int
  nome      String
  cognome   String
  via       String
  citta     String
  cap       String
  cf        String?
  piva      String?
  eliminato Boolean     @default(false)

  utente    Utente      @relation(fields: [id_Utente], references: [id])
  pazienti  Paziente[]
  pagamenti Pagamento[]

  // cf/piva sono univoci per utente SOLO tra i paganti attivi (eliminato =
  // false): applicato con indici unique parziali in
  // prisma/migrations/<timestamp>_paganti_partial_unique_active_only/migration.sql,
  // non rappresentabili con @@unique nel DSL di Prisma. NON riaggiungere
  // @@unique([id_Utente, cf]) / @@unique([id_Utente, piva]) qui: `prisma
  // migrate dev` li reintrodurrebbe come vincoli pieni, riaprendo il bug.
  @@index([id_Utente, eliminato])
  @@map("paganti")
}

model Paziente {
  id         Int         @id @default(autoincrement())
  id_Utente  Int
  id_Pagante Int?
  nome       String
  cognome    String
  eliminato  Boolean     @default(false)

  utente     Utente      @relation(fields: [id_Utente], references: [id])
  pagante    Pagante?    @relation(fields: [id_Pagante], references: [id])
  sedute     Seduta[]
  pagamenti  Pagamento[]

  @@index([id_Utente, eliminato])
  @@map("pazienti")
}

model Pagamento {
  id                  Int           @id @default(autoincrement())
  id_Utente           Int
  id_Pagante          Int
  id_Paziente         Int
  prezzo_totale       Decimal        @db.Decimal(10, 2)
  mod_pag             ModalitaPagamento
  sedute              Int?
  commento            String?
  n_fattura           Int
  anno                Int
  data                DateTime
  citta               String
  cap                 String
  pdfLayoutSnapshot   Json?
  bolloCodice         String?        @unique

  utente              Utente         @relation(fields: [id_Utente], references: [id])
  pagante             Pagante        @relation(fields: [id_Pagante], references: [id])
  paziente            Paziente       @relation(fields: [id_Paziente], references: [id])
  mesi                FatturaMese[]

  @@unique([id_Utente, n_fattura, anno])
  @@index([id_Utente, data])
  @@map("pagamenti")
}

model ImpostazioniPdf {
  id           Int      @id @default(autoincrement())
  id_Utente    Int      @unique
  pageWidth    Int      @default(595)
  pageHeight   Int      @default(842)
  marginTop    Int      @default(40)
  marginRight  Int      @default(40)
  marginBottom Int      @default(40)
  marginLeft   Int      @default(40)
  fontFamily   String   @default("Helvetica")
  fontSizeBase Int      @default(11)
  blocchi      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  utente       Utente   @relation(fields: [id_Utente], references: [id])

  @@map("impostazioni_pdf")
}

model FatturaMese {
  id           Int       @id @default(autoincrement())
  id_Pagamento Int
  mese         String
  prezzo       Decimal   @db.Decimal(10, 2)

  pagamento    Pagamento @relation(fields: [id_Pagamento], references: [id], onDelete: Cascade)

  @@unique([id_Pagamento, mese])
  @@map("fattura_mesi")
}

enum ModalitaPagamento {
  CONTANTI
  CARTA
  BONIFICO
}

model Seduta {
  id          Int      @id @default(autoincrement())
  id_Paziente Int
  prezzo      Float
  data        DateTime
  pagato      Boolean  @default(false)

  paziente    Paziente @relation(fields: [id_Paziente], references: [id])

  @@map("sedute")
}