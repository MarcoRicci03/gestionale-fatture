generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
}

model Utente {
  id               Int              @id @default(autoincrement())
  username         String           @unique
  passwordHash     String
  nome             String?
  cognome          String?
  pIva             String?
  cf               String?
  via              String?
  citta            String?
  cap              String?
  provincia        String?
  titolo           String?
  specializzazione String?
  isAdmin          Boolean          @default(false)
  abilitato        Boolean          @default(true)
  // Incrementato ad ogni cambio/reset password (lib/actions/account.ts,
  // lib/actions/users.ts). Il JWT di sessione porta il valore letto al momento
  // della firma (lib/auth/jwt.ts): se non coincide più con quello corrente in
  // DB, getSession() tratta la sessione come invalidata (lib/auth/session.ts).
  // Così un cambio password revoca immediatamente ogni sessione firmata prima
  // (es. un cookie rubato), anche se il JWT non è ancora scaduto.
  tokenVersion     Int              @default(0)
  createdAt        DateTime         @default(now())

  paganti          Pagante[]
  pazienti         Paziente[]
  pagamenti        Pagamento[]
  impostazioniPdf  ImpostazioniPdf?
  auditLogs        AuditLog[]

  @@map("utenti")
}

model Pagante {
  id         Int         @id @default(autoincrement())
  id_Utente  Int
  nome       String
  cognome    String
  via        String
  citta      String
  cap        String
  cf         String?
  piva       String?
  // Rinominato da `eliminato` (era soft-delete puro): ora significa
  // "archiviato" — sparisce da elenchi operativi e tendine, ma le sue
  // fatture restano visibili/esportabili (vedi lib/data/invoices.ts). Il
  // @map mantiene invariato il nome colonna in DB, quindi nessuna migration
  // di dati è necessaria per questo rename.
  archiviato Boolean     @default(false) @map("eliminato")

  utente     Utente      @relation(fields: [id_Utente], references: [id])
  pazienti   Paziente[]
  pagamenti  Pagamento[]

  // cf/piva sono univoci per utente SOLO tra i paganti attivi (archiviato =
  // false): applicato con indici unique parziali in
  // prisma/migrations/20260720000000_init/migration.sql (righe 129-130),
  // non rappresentabili con @@unique nel DSL di Prisma. NON riaggiungere
  // @@unique([id_Utente, cf]) / @@unique([id_Utente, piva]) qui: `prisma
  // migrate dev` li reintrodurrebbe come vincoli pieni, riaprendo il bug.
  // Questi indici parziali non sono introspettabili da Prisma: un futuro
  // `prisma migrate dev` potrebbe segnalarli come drift non dichiarato nello
  // schema. È atteso, non un'indicazione di rigenerare la migration. Se in
  // futuro si usa `prisma db push` in dev, questi indici andrebbero
  // ricreati manualmente (db push non replica migration SQL custom).
  @@index([id_Utente, archiviato])
  @@map("paganti")
}

model Paziente {
  id         Int         @id @default(autoincrement())
  id_Utente  Int
  id_Pagante Int?
  nome       String
  cognome    String
  // Vedi commento su Pagante.archiviato: stesso rename, stesso @map.
  archiviato Boolean     @default(false) @map("eliminato")

  utente     Utente      @relation(fields: [id_Utente], references: [id])
  // onDelete: Cascade (era SET NULL): un hard-delete del pagante (azione
  // hardDeletePayer in lib/actions/payers.ts) può avvenire solo quando non
  // restano pazienti collegati non archiviati (guard applicativo in
  // lib/archive/guards.ts) — a quel punto i soli pazienti ancora collegati
  // sono già archiviati e senza fatture, ed è corretto cancellarli insieme
  // al pagante invece di lasciarli con un id_Pagante orfano.
  pagante    Pagante?    @relation(fields: [id_Pagante], references: [id], onDelete: Cascade)
  pagamenti  Pagamento[]

  @@index([id_Utente, archiviato])
  @@map("pazienti")
}

model Pagamento {
  id                  Int           @id @default(autoincrement())
  id_Utente           Int
  id_Pagante          Int
  id_Paziente         Int
  prezzo_totale       Decimal        @db.Decimal(10, 2)
  mod_pag             ModalitaPagamento
  sedute              Int?
  commento            String?
  n_fattura           Int
  anno                Int
  data                DateTime
  citta               String
  cap                 String
  pdfLayoutSnapshot   Json?
  bolloCodice         String?

  utente              Utente         @relation(fields: [id_Utente], references: [id])
  pagante             Pagante        @relation(fields: [id_Pagante], references: [id])
  paziente            Paziente       @relation(fields: [id_Paziente], references: [id])
  mesi                FatturaMese[]

  @@unique([id_Utente, n_fattura, anno])
  @@index([id_Utente, data])
  @@unique([id_Utente, bolloCodice])
  @@map("pagamenti")
}

model ImpostazioniPdf {
  id           Int      @id @default(autoincrement())
  id_Utente    Int      @unique
  pageWidth    Int      @default(595)
  pageHeight   Int      @default(842)
  marginTop    Int      @default(40)
  marginRight  Int      @default(40)
  marginBottom Int      @default(40)
  marginLeft   Int      @default(40)
  fontFamily   String   @default("Helvetica")
  fontSizeBase Int      @default(11)
  blocchi      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  utente       Utente   @relation(fields: [id_Utente], references: [id])

  @@map("impostazioni_pdf")
}

model FatturaMese {
  id           Int       @id @default(autoincrement())
  id_Pagamento Int
  mese         String
  prezzo       Decimal   @db.Decimal(10, 2)

  pagamento    Pagamento @relation(fields: [id_Pagamento], references: [id], onDelete: Cascade)

  @@unique([id_Pagamento, mese])
  @@map("fattura_mesi")
}

enum ModalitaPagamento {
  CONTANTI
  CARTA
  BONIFICO
}

// SEC-15: traccia login/logout e ogni mutazione sensibile (vedi
// lib/audit/log.ts). id_Utente è l'attore che ha compiuto l'azione (per le
// action admin-only, es. resetUserPassword, è l'admin, non l'utente target).
// entita/entitaId NON sono una relazione Prisma: identificano polimorficamente
// una riga in un altro model (es. "Pagamento"/id) tramite una stringa libera,
// perché deleteInvoice fa hard-delete (LOG-03) e l'id deve restare leggibile
// nel log anche dopo che la riga referenziata non esiste più.
model AuditLog {
  id        Int      @id @default(autoincrement())
  id_Utente Int?
  azione    String
  entita    String?
  entitaId  Int?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  utente    Utente?  @relation(fields: [id_Utente], references: [id])

  @@index([id_Utente, createdAt])
  @@index([azione, createdAt])
  @@map("audit_logs")
}
